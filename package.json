{
  "name": "udemy-playwright",
  "version": "1.0.0",
  "description": "Automated software testing with Playwright",
  "main": "index.js",
  "scripts": {
    "tests:chrome": "playwright test --config=playwright.config.ts --project=Chromium --reporter=list",
    "tests:firefox": "playwright test --config=playwright.config.ts --project=Firefox --reporter=list",
    "tests:webkit": "playwright test --config=playwright.config.ts --project=Webkit --reporter=list",
    "tests:e2e": "playwright test --config=e2e.config.ts --project=Chromium --reporter=list",
    "tests:e2eh": "playwright test --config=e2e.config.ts --project=Chromium --reporter=list --headed",
    "tests:visual:chrome": "playwright test --config=visual.config.ts --project=Chromium --reporter=list",
    "tests:visual:firefox": "playwright test --config=visual.config.ts --reporter=list --project=Firefox",
    "tests:visual:webkit": "playwright test --config=visual.config.ts --reporter=list --project=Webkit",
    "tests:visual:chrome:update": "playwright test --config=visual.config.ts --project=Chromium --reporter=list --update-snapshots",
    "tests:visual:firefox:update": "playwright test --config=visual.config.ts --project=Firefox --reporter=list --update-snapshots",
    "tests:visual:webkit:update": "playwright test --config=visual.config.ts --project=Webkit --reporter=list --update-snapshots",
    "tests:api": "playwright test --config=api.config.ts --project=Chromium --reporter=list",
    "jenkins": "java -jar jenkins.war --httpPort=8080",
    "tests:tips": "playwright test --config=playwright.config.ts --project=Chromium --reporter=list"

  },
  "author": "Kane",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.62.1"
  }
}
